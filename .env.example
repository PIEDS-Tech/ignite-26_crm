# Copy to .env and fill in. Never commit .env.

# ==========================================================================
# core_django — the hosted CRM (DigitalOcean). Not needed on member laptops.
# ==========================================================================
DATABASE_URL=postgres://ignite:ignite@localhost:5432/ignite_crm
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================================================
# local_agent — runs on each team member's laptop.
# Note there is NO DATABASE_URL here: the agent has no database access.
# ==========================================================================

# The hosted CRM. In production this is your DigitalOcean URL (https://…).
AGENT_API_BASE_URL=http://localhost:8000

# Issued by a lead on the CRM's "Team & Tokens" page. Shown once — if you lose
# it, have a new one issued and revoke the old.
AGENT_API_TOKEN=

# Your BITS address. Must match both the API token's owner and the Gmail
# account you sign in with; the agent refuses to start otherwise.
AGENT_MEMBER_EMAIL=yourname@pilani.bits-pilani.ac.in

# Desktop-app OAuth client JSON from Google Cloud Console
# (APIs & Services > Credentials > Create OAuth client ID > Desktop app).
GOOGLE_CLIENT_SECRETS_PATH=./client_secret.json

# Where cached Gmail tokens live (chmod 600). Default is fine.
AGENT_TOKEN_DIR=~/.ignite_crm

# Pacing between sends within a batch. The hard daily cap is server-side.
AGENT_SEND_DELAY_SECONDS=2
