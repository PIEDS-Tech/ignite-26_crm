# Copy to .env and fill in. Never commit .env.

# ==========================================================================
# core_django — the hosted CRM. Not needed on member laptops.
# ==========================================================================

# Local development: the Docker Postgres from docker-compose.yml.
DATABASE_URL=postgres://ignite:ignite@localhost:5432/ignite_crm

# Production: Supabase. Use the SESSION POOLER, port 5432 — copy it from
# Project Settings > Database > Connection string > Session pooler. It looks like:
#
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Do NOT use port 6543 (transaction pooler) — the row locks in
# services/mailing.py depend on session-mode behaviour, and psycopg3's prepared
# statements break there. If you must, set DB_TRANSACTION_POOLER=True as well.
# Do NOT use db.<project-ref>.supabase.co directly — IPv6-only without the
# paid IPv4 add-on.
#
# Tests ignore this value entirely and always use local Postgres.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sign-in. Batch 2024 picks a name -- nothing to configure. Batch 2025 signs in
# with Google, which needs a WEB OAuth client (Google Cloud Console >
# Credentials > Create OAuth client ID > *Web application*). This is a DIFFERENT
# client from the Desktop one the agent uses for Gmail.
#
# Authorised redirect URI, exactly:
#   http://localhost:8000/login/google/callback/
#
# Leave blank to disable the Google door; the login page then says so.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_HOSTED_DOMAIN=pilani.bits-pilani.ac.in

# Persistent connections. 0 is right behind a pooler with limited slots.
DB_CONN_MAX_AGE=0
DB_TRANSACTION_POOLER=False

# ==========================================================================
# local_agent — runs on each team member's laptop.
# Note there is NO DATABASE_URL here: the agent has no database access.
# ==========================================================================

# The hosted CRM. In production this is your DigitalOcean URL (https://…).
AGENT_API_BASE_URL=http://localhost:8000

# Issued by a lead on the CRM's "Team & Tokens" page. Shown once — if you lose
# it, have a new one issued and revoke the old.
AGENT_API_TOKEN=

# Your BITS address. Must match both the API token's owner and the Gmail
# account you sign in with; the agent refuses to start otherwise.
AGENT_MEMBER_EMAIL=yourname@pilani.bits-pilani.ac.in

# Desktop-app OAuth client JSON from Google Cloud Console
# (APIs & Services > Credentials > Create OAuth client ID > Desktop app).
GOOGLE_CLIENT_SECRETS_PATH=./client_secret.json

# Where cached Gmail tokens live (chmod 600). Default is fine.
AGENT_TOKEN_DIR=~/.ignite_crm

# Pacing between sends within a batch. The hard daily cap is server-side.
AGENT_SEND_DELAY_SECONDS=2

# --- scheduled sending ----------------------------------------------------
# Gmail has no sendAt, so a scheduled mail goes out only while an agent is
# running for that member. See docs/MAIL_SCHEDULING.md.

# How often this agent asks the CRM for work that has fallen due.
AGENT_SCHEDULE_POLL_SECONDS=60

# Jobs leased per poll. A cap, not a target -- the rest wait one minute.
AGENT_SCHEDULE_CLAIM_LIMIT=5

# Who holds a lease, shown in the CRM. Defaults to hostname:pid; set it to
# something readable when several agents run on one box.
# AGENT_ID=always-on

# --- scheduling rules (CRM side) ------------------------------------------
# Delivery window in TIME_ZONE (Asia/Kolkata). A job falling due outside it
# waits for the next open slot instead of mailing someone at 3am.
# Set START == END to disable the window entirely.
SCHEDULE_WINDOW_START=9
SCHEDULE_WINDOW_END=19

# Days mail may go out. Monday is 0. Drop 5,6 for weekdays only.
SCHEDULE_WINDOW_DAYS=0,1,2,3,4,5,6

# How late a job may still send. Measured from when it was first ALLOWED to
# run, not from its scheduled time -- a job deferred overnight by the window
# must not be marked missed for a delay the system itself imposed.
SCHEDULE_GRACE_HOURS=6

# ==========================================================================
# docker compose only. Ignored by a native run.
# ==========================================================================

# Runs the local Postgres container. Delete this line (or empty it) once
# DATABASE_URL_DOCKER points at Supabase -- otherwise you are running a database
# nobody connects to.
COMPOSE_PROFILES=localdb

# Host-side Postgres port. Change it if another project already owns 5432;
# nothing inside the stack notices. Tests run from the host expect 5432.
PG_HOST_PORT=5432

# Both default to "whether the database is local": on a throwaway local Postgres
# they run every boot, on a shared hosted one they are skipped. Set explicitly
# only to override -- RUN_MIGRATIONS=true on the ONE machine that owns the
# schema, and leave SEED_DEV alone unless you want fixture data.
RUN_MIGRATIONS=
SEED_DEV=

# Overrides DATABASE_URL for the crm container only, so the value above can
# keep pointing at localhost for host-side tests. Point this at the Supabase
# session pooler to run the stack without the local Postgres.
DATABASE_URL_DOCKER=postgres://ignite:ignite@postgres:5432/ignite_crm

# Host directory mounted at /tokens in the agent container. It holds
# client_secret.json and the cached Gmail token_*.json.
AGENT_TOKEN_DIR_HOST=~/.ignite_crm
